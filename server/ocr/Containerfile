ARG OCR_RUNTIME_IMAGE=localhost/ocr-document-runtime:3.0.0-cu126
FROM ${OCR_RUNTIME_IMAGE}
WORKDIR /app
COPY requirements.txt .
RUN python -m pip uninstall -y PyMuPDF \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && python -c 'import importlib.util; assert importlib.util.find_spec("fitz") is None'
COPY server.py word_geometry.py image_processing.py pdf_document.py document_jobs.py .
ENV OCR_DEVICE=gpu:0
ENV PADDLE_PDX_CACHE_HOME=/cache/paddlex HF_HOME=/cache/huggingface
ENV OCR_JOB_DIR=/jobs PYTHONDONTWRITEBYTECODE=1
EXPOSE 8765
CMD ["python","-m","uvicorn","server:app","--host","0.0.0.0","--port","8765","--workers","1"]
