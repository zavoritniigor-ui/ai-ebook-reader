{
  "permissions": {
    "allow": [
      "Bash(gh run *)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git clean -*f*)",
      "Bash(git restore .)",
      "Bash(git checkout -- .)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-js-syntax.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
